{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@wa-chat/shared": ["packages/shared/src"],
      "@wa-chat/config": ["packages/config/src"],
      "@wa-chat/llm": ["packages/llm/src"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
